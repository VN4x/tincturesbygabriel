# Shared signing secret for entitlement + short-lived book URLs
ACCESS_SECRET=change-me-in-production

# Path to the reflowable EPUB (Podman volume). Do not put this file in public/.
# Local (npm run dev):
BOOK_PATH=private/books/metsa-vagi.epub
BOOK_PATH_EN=private/books/metsa-vagi.en.epub
# Podman: BOOK_PATH=/data/books/metsa-vagi.epub


# Local file-ledger panel at /ops — never link this from the public site.
# Production: long random password (12+ chars). Unset in production refuses login.
ADMIN_EMAIL=gabriel@corpus.ee
ADMIN_PASSWORD=change-me-to-a-long-secret
# JSON ledger (gitignored via private/). On Podman / durable Node host: /data/admin/store.json
# Must be a shared writable path. Memory-only store cannot survive webhook vs OTP on another instance.
# ADMIN_STORE_PATH=

# Optional remote source (signed S3/R2 URL fetched server-side). Used on Cloudflare/Lovable.
# BOOK_URL=

# Comma-separated friend-account invite codes
INVITE_TOKENS=METSAVAGI-FRIEND

# Production OTP: set Resend + a domain with SPF/DKIM/DMARC. Without RESEND_API_KEY, mock codes
# work only when NODE_ENV is not production. Codes are never sent to unknown emails.
# RESEND_API_KEY=
# OTP_FROM=Metsa vägi <raamat@your-domain.ee>
# OTP_DOMAIN=your-domain.ee
# Check DNS: node -e "import('./src/lib/email-dns.ts').then(m=>m.checkEmailDns(process.env.OTP_DOMAIN).then(console.log))"

# Stripe. Dashboard webhook URL: https://<host>/api/stripe/webhook  events: checkout.session.completed
# Checkout always sends customer_email + metadata[email]. Webhook writes the ledger without cookies.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=
# PUBLIC_SITE_URL=https://tincturesbygabriel.lovable.app

# Cloud auth + ADMIN UI at /admin (optional). Without these, cookie OTP + /ops still work.
# After a paid webhook, fulfillPaidAccess also tries to create a confirmed Supabase user so /auth OTP works.
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Nitro: cloudflare-module (Lovable default) or node-server (Podman)
# NITRO_PRESET=node-server

# Refresh Lovable UI snapshot (gitignored): npm run snapshot:lovable
# Never git pull origin/main into this working tree. Do not force-push main.
